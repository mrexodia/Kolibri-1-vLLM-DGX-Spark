# Copy to .env and adjust only if needed.
PORT=8888
MAX_MODEL_LEN=262144
# 0.70 leaves RAM for agents and builds on the GB10 unified-memory system.
GPU_MEMORY_UTILIZATION=0.70
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
STARTUP_TIMEOUT=2400

# The default is ~/.cache/huggingface, matching `hf download`.
# HOST_HF_HOME=/home/user/.cache/huggingface

# Advanced: free-form vLLM arguments appended last.
# EXTRA_ARGS=--enforce-eager
